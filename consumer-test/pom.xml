<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Standalone parent — intentionally NOT a child of the stripe project.
        This simulates an arbitrary third-party Element that depends on the Stripe Element.

        Before building, install the Stripe Element into your local Maven repository:
            cd .. && mvn install

        Then build and run the integration tests:
            mvn verify
    -->

    <groupId>dev.getelements.elements.stripe.consumer.test</groupId>
    <artifactId>consumer-test</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Stripe Element Consumer Test</name>
    <description>
        Example consumer Element that declares an ElementDependency on the Stripe Element.
        Used to verify cross-Element event delivery and attribute override behaviour end-to-end.
    </description>

    <modules>
        <module>element</module>
        <module>integration-test</module>
    </modules>

    <properties>
        <encoding>UTF-8</encoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <elements.version>3.7.20</elements.version>
        <stripe.element.version>1.0-SNAPSHOT</stripe.element.version>
        <guice.version>7.0.0</guice.version>
        <stripe.java.version>25.3.0</stripe.java.version>
        <api.classifier>dev.getelements.elements.stripe.consumer.test.api</api.classifier>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>dev.getelements.elements</groupId>
                <artifactId>sdk-bom</artifactId>
                <version>${elements.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Stripe Element API (unclassified) — provided at runtime by the Stripe Element's classloader -->
            <dependency>
                <groupId>dev.getelements.elements.stripe</groupId>
                <artifactId>api</artifactId>
                <version>${stripe.element.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Stripe Element implementation JAR — used only in integration-test for constant access -->
            <dependency>
                <groupId>dev.getelements.elements.stripe</groupId>
                <artifactId>element</artifactId>
                <version>${stripe.element.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>com.stripe</groupId>
                <artifactId>stripe-java</artifactId>
                <version>${stripe.java.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
